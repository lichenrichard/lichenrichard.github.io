---
import Photo from './Photo.astro';
const { item } = Astro.props;
---
<article class="media-card">
  <div class:list={['media-frame', { 'video-frame': item.videoId }]}>
    {item.videoId ? <div class="video-facade" data-video-id={item.videoId} data-video-title={item.title}>
      <Photo src={item.image} alt="" sizes="(max-width: 650px) 100vw, 50vw" />
      <a class="play-control" href={item.url} aria-label={`Watch ${item.title}`}><span class="play-icon" aria-hidden="true">▶</span><span>Watch video</span></a>
    </div> : <a href={item.url} tabindex="-1" aria-hidden="true"><Photo src={item.image} alt="" sizes="(max-width: 650px) 100vw, 50vw" /><span class="article-label">IN THE NEWS ↗</span></a>}
  </div>
  <div class="media-meta">{item.provider}{item.language && <><span aria-hidden="true"> / </span>{item.language}</>}</div>
  <h3><a href={item.url}>{item.title}</a></h3>
  <p>{item.description}</p>
  <a class="text-link small" href={item.url}>{item.videoId ? 'Watch on YouTube' : 'Read the story'} ↗</a>
</article>
<script>
  document.querySelectorAll<HTMLElement>('.video-facade').forEach(facade => {
    const anchor = facade.querySelector<HTMLAnchorElement>('.play-control');
    if (!anchor) return;
    const button = document.createElement('button');
    button.type = 'button';
    button.className = anchor.className;
    button.innerHTML = anchor.innerHTML;
    button.setAttribute('aria-label', anchor.getAttribute('aria-label') || 'Play video');
    anchor.replaceWith(button);
    button.addEventListener('click', () => {
      const id = facade.dataset.videoId;
      if (!id || !/^[\w-]{11}$/.test(id)) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&origin=${encodeURIComponent(window.location.origin)}`;
      iframe.title = facade.dataset.videoTitle || 'Project video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      facade.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
