---
import ArrowUpRight from '../components/ArrowUpRight.astro';
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PublicationRow from '../components/PublicationRow.astro';
import { site } from '../data/site';
import projects from '../data/projects.json';
import publications from '../data/publications.json';
const featuredProjects = ['esaias', 'hkchvr', 'rcvr'].map(id => projects.find(p => p.id === id)!);
const featuredPapers = publications.filter(p => p.featured).sort((a,b) => b.year-a.year);
---
<Layout title={`${site.name} | Human-centred Computing Researcher`} description="Chen Li, Assistant Professor at The Hong Kong Polytechnic University. Research in human–computer interaction, extended reality, learning, and wellbeing.">
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy"><span class="hero-greeting">Hello, world.</span><h1 id="hero-title">I’m Chen <br /><em>'Richard' Li</em></h1><p class="hero-intro">I’m an <strong>Assistant Professor at The Hong Kong Polytechnic University</strong>. I design and study technologies that support how we learn, connect, and care for one another.</p><div class="hero-actions"><a class="button button-primary" href="/project.html">Explore my research <ArrowUpRight /></a><a class="button button-secondary" href="/publication.html">View publications <span aria-hidden="true">→</span></a></div></div>
      <figure class="portrait-wrap"><div class="portrait"><Photo src="/images/avatar-2.webp" alt={site.name} eager sizes="(max-width: 600px) 84px, (max-width: 1050px) 310px, 370px" /></div><figcaption class="portrait-caption"><div><strong>{site.name}</strong><span>Assistant Professor · PolyU</span></div><span class="portrait-symbol" aria-hidden="true">✳</span></figcaption></figure>
    </section>
    <div class="affiliation-strip"><strong>The Hong Kong Polytechnic University</strong><span>Department of Applied Social Sciences<br />Department of Computing</span><span class="location">Hong Kong <ArrowUpRight /></span></div>
    <section class="section" aria-labelledby="themes-title" style="border-top:0">
      <div class="section-heading"><div><span class="eyebrow"><span class="section-number">01</span> Research interests</span><h2 id="themes-title">Human needs.<br />New possibilities.</h2></div><p>I work across disciplines to bring human-centred computing into education, healthcare, and everyday life.</p></div>
      <div class="themes">
        <article class="theme"><span class="theme-icon" aria-hidden="true">◈</span><h3>Immersive experiences</h3><p>Exploring how virtual and augmented reality can create meaningful ways to interact, collaborate, and connect.</p><a class="text-link small" href="/publication.html?topic=vr-ar">Explore VR / AR research →</a></article>
        <article class="theme"><span class="theme-icon" aria-hidden="true">✳</span><h3>Learning & inclusion</h3><p>Designing accessible learning experiences, from social skills practice to human–AI collaboration.</p><a class="text-link small" href="/publication.html?topic=education">Explore learning research →</a></article>
        <article class="theme"><span class="theme-icon" aria-hidden="true">◎</span><h3>Health & wellbeing</h3><p>Investigating how technology can support care, reduce anxiety, and bring people together through therapy.</p><a class="text-link small" href="/publication.html?topic=wellbeing">Explore wellbeing research →</a></article>
      </div>
    </section>
    <section class="section" aria-labelledby="projects-title"><div class="section-heading"><div><span class="eyebrow"><span class="section-number">02</span> Selected projects</span><h2 id="projects-title">Research in practice.</h2></div><a class="text-link" href="/project.html">All research projects <ArrowUpRight /></a></div><div class="project-grid home-projects">{featuredProjects.map((project,index) => <ProjectCard project={project} index={index} />)}</div></section>
    <section class="section" aria-labelledby="publications-title"><div class="section-heading"><div><span class="eyebrow"><span class="section-number">03</span> Selected recent publications</span><h2 id="publications-title">Ideas, investigated.</h2></div><a class="text-link" href="/publication.html">Browse all publications <ArrowUpRight /></a></div><div>{featuredPapers.map(publication => <PublicationRow publication={publication} compact />)}</div></section>
    <section class="section about-preview" aria-labelledby="about-title"><div><span class="eyebrow"><span class="section-number">04</span> A little about me</span><h2 id="about-title">Across disciplines.<br />Closer to people.</h2></div><div class="prose"><p>My work brings together computing, education, and the social sciences. I collaborate with researchers and practitioners from different backgrounds to develop technologies that support people in their daily lives.</p><p>My research on virtual reality for children with special educational needs has been adopted by mainstream and special schools in Hong Kong. Before joining PolyU, I worked at City University of Hong Kong’s AIMtech Centre and the University of Canterbury’s HIT Lab NZ.</p><a class="text-link" href="/about.html">More about my background & service →</a></div></section>
    <section class="contact-panel" id="contact" aria-labelledby="contact-title"><div><span class="eyebrow">Let’s work together</span><h2 id="contact-title">Curious about what<br />we could build?</h2><p>I welcome conversations with prospective research students, collaborators, and practitioners interested in human-centred computing.</p><a class="button button-primary" href={`mailto:${site.email}`}>Get in touch <ArrowUpRight /></a><p class="contact-email"><a href={`mailto:${site.email}`}>{site.email}</a></p></div><div class="opening"><span class="status-badge">Research opportunities</span><h3>Join the journey</h3><p>I’m looking for motivated postgraduate research students with backgrounds in computer science, creative media, communication, or psychology.</p><p><strong>Research Assistant · Full-time</strong><br />Cross-cultural HCI</p><a class="text-link small" href={`mailto:${site.email}?subject=Research%20opportunities`}>Enquire about opportunities →</a></div></section>
  </div>
</Layout>
<style>.contact-email { margin-bottom: 0; font-size: .78rem; overflow-wrap: anywhere; }.contact-email a { text-decoration: none; }</style>
